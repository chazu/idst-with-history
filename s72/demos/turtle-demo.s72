(Transcript print: "=== S72 Turtle Graphics Demo ===")
(Transcript print: "")

(Transcript print: "1. Drawing a simple line:")
(Turtle clear)
(Turtle forward: 10)
(Turtle show)
(Turtle position)

(Transcript print: "")
(Transcript print: "2. Testing pen up/down:")
(Turtle clear)
(Turtle goto: 0 0)
(Turtle forward: 3)
(Turtle penUp)
(Turtle forward: 3)
(Turtle penDown)
(Turtle forward: 3)
(Turtle show)

(Transcript print: "")
(Transcript print: "3. Moving without drawing:")
(Turtle clear)
(Turtle penUp)
(Turtle goto: 5 2)
(Turtle penDown)
(Turtle forward: 8)
(Turtle show)

(Transcript print: "")
(Transcript print: "Demo complete!")
